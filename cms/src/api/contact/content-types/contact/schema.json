{
  "kind": "collectionType",
  "collectionName": "contacts",
  "info": {
    "singularName": "contact",
    "pluralName": "contacts",
    "displayName": "contact"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 38,
      "regex": "^[A-Za-z]+(?: [A-Za-z]+)*$"
    },
    "email": {
      "type": "string",
      "minLength": 6,
      "maxLength": 70,
      "required": true,
      "regex": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
    },
    "message": {
      "type": "text",
      "minLength": 22,
      "maxLength": 4000,
      "regex": "^(?!.*<[^>]*>)(?!.*(?:javascript|vbscript|data):)(?!.*(?:<|>|&#|%3C|%3E))(?!.*[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]).{1,1000}$"
    }
  }
}
